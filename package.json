{
  "name": "ashiato",
  "version": "0.1.0",
  "description": "PC 作業を自動記録し、Claude が作業ブロック整理・日報生成・履歴への質問応答をするデスクトップアプリ",
  "main": "dist/main.js",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "dev": "node build.mjs && electron . --inspect",
    "typecheck": "tsc -p .",
    "dist": "node build.mjs --prod && electron-builder"
  },
  "author": "Shinsaku Nakagawa",
  "license": "MIT",
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@types/node": "^26.6.6",
    "dompurify": "^3.4.17",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "marked": "^18.1.3",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "productName": "Ashiato",
  "private": true,
  "build": {
    "appId": "dev.ashiato.journal",
    "productName": "Ashiato",
    "executableName": "Ashiato",
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Ashiato-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Ashiato-${version}-portable.${ext}"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
